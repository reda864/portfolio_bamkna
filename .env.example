# ==============================================================================
# Baamakna 3X3 - Environment Variables Configuration
# ==============================================================================

# 1. Neon PostgreSQL Database Connection URL
# Get this from your Neon Console (https://console.neon.tech)
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. JWT Authentication Secret Key
# Generate a strong random key for signing admin authentication tokens
JWT_SECRET=super_secure_random_jwt_secret_key_change_me_in_production

# 3. Initial Admin Credentials (seeded into Neon on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# 4. Server Port (Render sets this automatically)
PORT=5000
NODE_ENV=production
